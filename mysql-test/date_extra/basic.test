--disable_query_log
SELECT DATE_BIN(900, '2026-07-27 12:34:56');
SELECT DATE_BIN(3600, '1969-12-31 23:30:00');
SELECT TIME_BUCKET(86400, '2026-07-27 12:34:56');
SELECT DATE_CEIL('2026-07-27 12:34:56.123456', 'hour');
SELECT DATE_CEIL('2026-07-27 12:00:00', 'hour');
SELECT DATE_ROUND('2026-07-27 12:29:59', 'hour');
SELECT DATE_ROUND('2026-07-27 12:30:00', 'hour');
SELECT DATE_CEIL('2026-01-31 12:00:00', 'month');
SELECT DATE_ROUND('2026-02-15 00:00:00', 'month');
SELECT DATE_CEIL('2026-07-27', 'fortnight') IS NULL;
SELECT BUSINESS_DAYS_BETWEEN('2026-07-24', '2026-07-27');
SELECT BUSINESS_DAYS_BETWEEN('2026-07-27', '2026-07-24');
SELECT BUSINESS_DAYS_BETWEEN('2026-07-25', '2026-07-27');
SELECT ADD_BUSINESS_DAYS('2026-07-24', 1);
SELECT ADD_BUSINESS_DAYS('2026-07-27', -1);
SELECT ADD_BUSINESS_DAYS('2026-07-25', 1);
SELECT ISO_WEEK_DATE('2021-01-01');
SELECT ISO_WEEK_DATE('2026-07-27');
SELECT DATE_BIN(0, '2026-07-27') IS NULL;
SELECT ISO_WEEK_DATE(NULL) IS NULL;
